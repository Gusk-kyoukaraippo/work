{
  "name": "excel-gate-mvp8-kit",
  "version": "0.8.0",
  "description": "HTMLに合った名前・保存済み表示のブックを生成するExcelゲート MVP8th",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/package.mjs",
    "build:dev": "node scripts/package.mjs --mode=development",
    "build:candidate": "node scripts/package.mjs --mode=candidate",
    "app:new": "node scripts/init-app.mjs",
    "encode:vba": "python3 scripts/encode-vba.py",
    "integrate": "node scripts/integrate.mjs",
    "verify:apps": "node scripts/integrate.mjs verify handoff-notes && node scripts/integrate.mjs verify community-care",
    "package:kit": "node scripts/package-kit.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
