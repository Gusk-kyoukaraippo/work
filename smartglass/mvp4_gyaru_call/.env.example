# MVP4th local settings.
# Twilio credentials can be placed here, but the recommended setup is to keep them in ../.env.
# Environment priority: shell env > this file > ../.env

# Twilio credentials.
# Recommended: keep these in ../.env so MVP1/MVP2/MVP3/MVP4 can share them.
# You may also uncomment and set them here if you want MVP4 to be standalone.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# MY_PHONE_NUMBER=+819012345678

# Just Press Record iCloud folder. Replace with the path confirmed in Finder.
WATCH_DIR=/Users/your-user/Library/Mobile Documents/iCloud~com~openplanetsoftware~just-press-record/Documents

# Audio validation and local working files.
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg
WORK_DIR=/Users/your-user/work/smartglass/mvp4_gyaru_call/recording_copies
STATE_FILE=/Users/your-user/work/smartglass/mvp4_gyaru_call/seen_recordings.json
RECORDING_EXTENSIONS=.m4a,.mp3,.wav,.caf,.aac
ICLOUD_SETTLE_SECONDS=3
DEBOUNCE_SECONDS=10

# Whisper settings.
# whisper_cpp uses the whisper.cpp CLI binary below.
WHISPER_BACKEND=whisper_cpp
WHISPER_CPP_BIN=/Users/your-user/work/tools/whisper.cpp/build/bin/whisper-cli
WHISPER_LANGUAGE=ja

# Set a local ggml/gguf large model path.
WHISPER_MODEL_PATH=/Users/your-user/work/tools/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin

# Only used if WHISPER_BACKEND=auto falls back to Python/openai-whisper.
WHISPER_MODEL=large-v3

# Optional full command template. Placeholders:
# {audio} {output_dir} {output_base} {model} {model_path} {language}
# Example whisper.cpp:
# WHISPER_COMMAND=/Users/your-user/work/tools/whisper.cpp/build/bin/whisper-cli -m {model_path} -f {audio} -l {language} -otxt -of {output_base}
WHISPER_COMMAND=
WHISPER_EXTRA_ARGS=

# LM Studio OpenAI-compatible API.
LMSTUDIO_BASE_URL=http://localhost:1234
# Confirmed from this Mac's /v1/models: openai/gpt-oss-20b
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_TIMEOUT_SECONDS=120
LMSTUDIO_TEMPERATURE=0.7
LMSTUDIO_MAX_TOKENS=1200

# Prompt knobs.
GYARU_SYSTEM_PROMPT=あなたは日本語の文章を自然なギャル語に変換する編集者です。意味、固有名詞、数字、日時、依頼内容は変えず、読み上げやすい短い文にしてください。出力は変換後の本文だけにしてください。
GYARU_USER_PROMPT=次の文字起こしを、電話で読み上げても自然なギャル語に変換して。要点は落とさず、盛りすぎず、でもギャルっぽくして。\n\n{text}

# Twilio reads the converted gyaru text aloud. Long text is truncated for the call.
TRANSCRIPT_MAX_CHARS=1200
NOTIFICATION_PREFIX=録音をギャル語に変換したよ。内容は次の通りです。

# Set to 1 to verify detection/probe/transcription/LM Studio conversion without placing a Twilio call.
DRY_RUN=0
